// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad"
    ],
    // Deliberately empty: "sway/window" (focused window title) was removed -
    // sway already shows the title in the window's own titlebar, and a long
    // title crowded the right-hand widgets.
    "modules-center": [],
    "modules-right": [
        "custom/tailscale",
        "custom/airpods",
        "custom/bluelight",
        "custom/screenshot",
        "idle_inhibitor",
        "pulseaudio",
        "network",
        "power-profiles-daemon",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "battery",
        "clock",
        "tray"
    ],
    // Tailscale tailnet indicator + switcher.
    //
    // Shows which account is active (home / rudder) and clicking switches to
    // the other one. The active profile is the row ending in '*' in
    // `tailscale switch --list`.
    //
    // REQUIRES the operator grant, PER PROFILE:
    //     sudo tailscale set --operator=$USER
    // OperatorUser is a per-profile pref, not global - setting it on one
    // tailnet does NOT carry to the other, and without it `switch --list`
    // returns 'Access denied: profiles access denied' and this module goes
    // blank. Both profiles have it set as of 2026-08-03.
    //
    // The handler is BACKGROUNDED (trailing &). waybar runs on-click
    // synchronously and does not repaint until it returns - so with the sleep
    // inline, the red state never rendered even though exec was producing it.
    //
    // CLICK FEEDBACK: the click drops a marker in $XDG_RUNTIME_DIR and signals
    // waybar BEFORE doing any work, so the button flips to a red 'switching'
    // state the instant it is pressed. The marker is checked first in exec, so
    // it wins over whatever the profile list says. After the switch it sleeps
    // 2s (both to let the tailnet settle and to keep the feedback visible),
    // clears the marker and signals again.
    //
    // The settle matters: right after `tailscale switch` the '*' marker is
    // briefly absent from the list, which would otherwise flash as 'unknown'.
    "custom/tailscale": {
        "return-type": "json",
        "exec": "if [ -e \"$XDG_RUNTIME_DIR/waybar-tailscale-switching\" ]; then printf '%s\\n' '{\"text\":\"\\uf021 \\u2026\",\"class\":\"switching\",\"tooltip\":\"switching tailnet\\u2026\"}'; else a=$(tailscale switch --list 2>/dev/null | awk 'NR>1 && $NF ~ /\\*$/ {print substr($NF,1,length($NF)-1)}'); t=$(tailscale switch --list 2>/dev/null | awk 'NR>1 && $NF ~ /\\*$/ {print $2}'); if [ -z \"$a\" ]; then printf '%s\\n' '{\"text\":\"\\uf0ac ?\",\"class\":\"unknown\",\"tooltip\":\"tailscale: no active profile\"}'; elif [ \"$a\" = home ]; then printf '{\"text\":\"\\uf0ac home\",\"class\":\"home\",\"tooltip\":\"tailnet: %s (home) \\u2014 click to switch to rudder\"}\\n' \"$t\"; else printf '{\"text\":\"\\uf1ad %s\",\"class\":\"work\",\"tooltip\":\"tailnet: %s (%s) \\u2014 click to switch to home\"}\\n' \"$a\" \"$t\" \"$a\"; fi; fi",
        "interval": 10,
        "signal": 9,
        "on-click": "{ touch \"$XDG_RUNTIME_DIR/waybar-tailscale-switching\"; pkill -RTMIN+9 waybar; o=$(tailscale switch --list 2>/dev/null | awk 'NR>1 && $NF !~ /\\*$/ && NF>0 {print $NF; exit}'); [ -n \"$o\" ] && tailscale switch \"$o\" >/dev/null 2>&1; sleep 2; rm -f \"$XDG_RUNTIME_DIR/waybar-tailscale-switching\"; pkill -RTMIN+9 waybar; } >/dev/null 2>&1 &",
        "tooltip": true
    },
    // AirPods connect/disconnect toggle.
    //
    // Plain connect/disconnect toggle.
    //
    // Unsolicited reconnects were NOT a bluez problem: blueman-applet had this
    // device in org.blueman.plugins.autoconnect and was calling
    // Device1.Connect() on a timer, above the bluez layer. Proved with btmon
    // ('< HCI Command: Create Connection' - we were the initiator) and D-Bus
    // tracing back to pid 2237. Clearing that gsettings key fixed it, so no
    // block/trust/connectable juggling is needed here.
    //
    // The logic now lives in ~/.local/bin/airpods rather than inline shell,
    // because it is no longer a one-liner: BlueZ reports "Connected: yes"
    // seconds to minutes before the A2DP sink exists, and connecting has to
    // wait for that sink and then explicitly claim the default + any streams
    // still on the laptop speakers. See that file for the full why.
    //
    // exec reports state every 5s; the click also sends RTMIN+8 so the icon
    // updates immediately instead of waiting for the next poll. The script
    // signals again when the sink actually lands, which is what flips the
    // button from "pending" to "connected".
    //
    // on-click backgrounds the toggle: connect blocks until the sink appears
    // (up to 45s) and waybar serialises click handlers, so running it in the
    // foreground would freeze the whole bar for the duration.
    "custom/airpods": {
        "return-type": "json",
        "exec": "$HOME/.local/bin/airpods status",
        "interval": 5,
        "signal": 8,
        "on-click": "$HOME/.local/bin/airpods toggle >/dev/null 2>&1 &",
        "tooltip": true
    },
    // Blue light filter toggle (wlsunset).
    //
    // Icon reflects state: moon while the filter is running, sun while it is
    // off. Both the schedule and the start/stop/status logic live in
    // ~/.local/bin/bluelight - see that file for why this one is not inline
    // shell like the modules above it.
    //
    // The click handler signals waybar itself (RTMIN+10), so the icon flips
    // immediately instead of waiting out the 30s poll. The poll is still here
    // to catch the daemon dying or being started from a terminal.
    "custom/bluelight": {
        "return-type": "json",
        "exec": "$HOME/.local/bin/bluelight status",
        "interval": 30,
        "signal": 10,
        "on-click": "$HOME/.local/bin/bluelight toggle",
        "tooltip": true
    },
    // Screenshot button.
    //
    // grimshot's "anything" target lets you either drag a crosshair region OR
    // click a window - one action covers both. It is a CLI tool with no GUI of
    // its own, which is why running it bare does nothing visible; it needs a
    // subcommand, and here the click supplies one.
    //
    // No script file needed: on-click takes a shell command directly.
    //   left click  -> savecopy: file in ~/Pictures AND on the clipboard
    //                  (the common case - paste straight into chat, and still
    //                   have the file afterwards)
    //   right click -> copy: clipboard only, no file
    //   middle click-> save: file only, no clipboard
    // --notify raises a desktop notification naming the saved file.
    // NOTE: the icon is written as a JSON \u escape rather than a literal
    // glyph. U+F030 is in the Unicode Private Use Area (Font Awesome 6 Free
    // Solid), and pasting it literally is fragile - it can be silently dropped
    // in transit, leaving "format": "" and an invisible module. The escape is
    // plain ASCII and waybar decodes it when parsing the JSON.
    "custom/screenshot": {
        "format": "\uf030",
        "tooltip": true,
        "tooltip-format": "Screenshot\nclick: save + clipboard \u00b7 right: clipboard only \u00b7 middle: file only",
        "on-click": "grimshot --notify savecopy anything",
        "on-click-right": "grimshot --notify copy anything",
        "on-click-middle": "grimshot --notify save anything"
    },
    // Modules configuration
    // "sway/workspaces": {
    //     "disable-scroll": true,
    //     "all-outputs": true,
    //     "warp-on-scroll": false,
    //     "format": "{name}: {icon}",
    //     "format-icons": {
    //         "1": "",
    //         "2": "",
    //         "3": "",
    //         "4": "",
    //         "5": "",
    //         "urgent": "",
    //         "focused": "",
    //         "default": ""
    //     }
    // },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 5,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    // Clock.
    //
    // Date AND time are always on the bar. Waybar's default "format" is time
    // only ({:%H:%M}) and the stock config put the date behind "format-alt",
    // i.e. only visible while toggled by a click - so the date was normally
    // absent. Both formats now carry the date; the alt one just adds seconds
    // and the week number, so no click can leave the date hidden.
    "clock": {
        // "timezone": "America/New_York",
        "format": "{:%a %Y-%m-%d %H:%M}",
        "format-alt": "{:%a %Y-%m-%d %H:%M:%S (W%V)}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 1
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["🌑", "🌘", "🌗", "🌖", "🌕"]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },
    "custom/power": {
        "format" : "⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    }
}
